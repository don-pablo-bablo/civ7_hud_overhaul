		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_CELEBRATION" Language="en_US">
			<Text>Celebration countdown</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_CELEBRATION_DESCRIPTION" Language="en_US">
			<Text>Adds the turns to the next celebration, or the turns left in the one running, to the happiness pill.</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_CITY_LIMIT_COUNT" Language="en_US">
