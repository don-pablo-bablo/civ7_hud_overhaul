<?xml version="1.0" encoding="utf-8"?>
<Database>
	<LocalizedText>
		<Replace Tag="LOC_OPTIONS_GROUP_HUD_OVERHAUL" Language="en_US">
			<Text>Pablo's HUD Overhaul</Text>
		</Replace>
		<Replace Tag="LOC_OPTIONS_GROUP_HUD_OVERHAUL_TOP_BAR" Language="en_US">
			<Text>Pablo's HUD Overhaul: Top bar</Text>
		</Replace>
		<Replace Tag="LOC_OPTIONS_GROUP_HUD_OVERHAUL_TOP_BAR_NOTE" Language="en_US">
			<Text>At lower resolutions, higher UI scaling or a bigger top bar, pills that do not fit go on an extra row. Turn off the ones you need least to save space.</Text>
		</Replace>
		<Replace Tag="LOC_OPTIONS_GROUP_HUD_OVERHAUL_PARTS" Language="en_US">
			<Text>Pablo's HUD Overhaul: Size and layout</Text>
		</Replace>
		<Replace Tag="LOC_OPTIONS_GROUP_HUD_OVERHAUL_PARTS_NOTE" Language="en_US">
			<Text>Turn off any part to use the game's version instead. Each size is a percentage of the mod's default.</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_PART_TOOLTIPS" Language="en_US">
			<Text>Detailed tooltips</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_PART_TOOLTIPS_DESCRIPTION" Language="en_US">
			<Text>Shows this mod's detailed tooltips on the top bar's pills. Turn off for the game's own tooltips.</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_PART_DOCK" Language="en_US">
			<Text>Rings and World Tracker</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_PART_DOCK_DESCRIPTION" Language="en_US">
			<Text>Shows smaller rings and buttons on a panel, with the World Tracker and the Journal under them. Turn off for the game's own dock and Journal.</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_PART_RIBBON" Language="en_US">
			<Text>Leader ribbon</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_PART_RIBBON_DESCRIPTION" Language="en_US">
			<Text>Shows the compact leader ribbon with its extra rows. Turn off for the game's own ribbon, or Drongo's when Drongo's Leader Ribbons is on.</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_PART_MINIMAP_DESCRIPTION" Language="en_US">
			<Text>Shows a smaller minimap in the corner. Turn off for the game's own.</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_PART_DIAL" Language="en_US">
			<Text>Turn dial and notifications</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_PART_DIAL_DESCRIPTION" Language="en_US">
			<Text>Shows a smaller turn dial in the corner, with the notifications lined up above it. Turn off for the game's own.</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_RIBBON_YIELDS" Language="en_US">
			<Text>Leader ribbon yields</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_RIBBON_YIELDS_DESCRIPTION" Language="en_US">
			<Text>When each leader's yields show under their portrait: on hover, as stock; yours always and the others on hover, as in Civilization VI; or everyone's always.</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_TRACKER" Language="en_US">
			<Text>World Tracker</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_TRACKER_DESCRIPTION" Language="en_US">
			<Text>Where your research and civic show: in the World Tracker, in the research and civic rings at the top of the dock, or both.</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_TRACKER_BOTH" Language="en_US">
			<Text>Both</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_TRACKER_ONLY" Language="en_US">
			<Text>World Tracker only</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_TRACKER_RINGS" Language="en_US">
			<Text>Rings only</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_DRONGO_RIBBON" Language="en_US">
			<Text>With Drongo's Leader Ribbons</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_DRONGO_RIBBON_DESCRIPTION" Language="en_US">
			<Text>How the leader ribbon looks with Drongo's Leader Ribbons on. Drongo's layout: Drongo's order, extra rows behind its +/- button and its combat strength, at HUD Overhaul's size and place. HUD Overhaul: every row in one list, with its combat strength. To use Drongo's ribbon unchanged, turn off Leader ribbon.</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_DRONGO_OWN" Language="en_US">
			<Text>HUD Overhaul</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_DRONGO_LAYOUT" Language="en_US">
			<Text>Drongo's layout</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_ON_HOVER" Language="en_US">
			<Text>On hover</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_OWN" Language="en_US">
			<Text>Yours always, others on hover</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_ALL" Language="en_US">
			<Text>Always for everyone</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_ENABLED" Language="en_US">
			<Text>Enable HUD Overhaul</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_ENABLED_DESCRIPTION" Language="en_US">
			<Text>Turn off to see the game's own HUD. Your choices below are kept for when you turn it back on.</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_PANEL_COLOUR" Language="en_US">
			<Text>Theme</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_PANEL_COLOUR_DESCRIPTION" Language="en_US">
			<Text>The colour of the top bar, the panels under it and the leader ribbon's backing.</Text>
		</Replace>
