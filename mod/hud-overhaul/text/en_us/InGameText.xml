		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_BAR_OPACITY" Language="en_US">
			<Text>Top bar opacity</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_BAR_OPACITY_DESCRIPTION" Language="en_US">
			<Text>How much of the map shows through the top bar.</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_PANEL_OPACITY" Language="en_US">
			<Text>Panel opacity</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_PANEL_OPACITY_DESCRIPTION" Language="en_US">
			<Text>How much of the map shows through the dock, the World Tracker and the Journal.</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_RIBBON_OPACITY" Language="en_US">
			<Text>Leader ribbon opacity</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_RIBBON_OPACITY_DESCRIPTION" Language="en_US">
			<Text>How much of the map shows through the backing behind each leader's portrait and yields.</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_ROWS" Language="en_US">
			<Text>Top bar rows</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_ROWS_DESCRIPTION" Language="en_US">
			<Text>Two rows puts your yields and victories on the first row and the rest on the second. One row puts every pill in a single line.</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_ROWS_ONE" Language="en_US">
			<Text>One row</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_ROWS_TWO" Language="en_US">
			<Text>Two rows</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_SIZE_TOP_BAR" Language="en_US">
			<Text>Top bar size</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_SIZE_TOP_BAR_DESCRIPTION" Language="en_US">
			<Text>The size of the top bar's pills, and of the turn and date at the top right. The base game's is about 120%.</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_SIZE_TOOLTIPS" Language="en_US">
			<Text>Tooltip size</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_SIZE_TOOLTIPS_DESCRIPTION" Language="en_US">
			<Text>The size of the top bar's detailed tooltips.</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_SIZE_DOCK" Language="en_US">
			<Text>Rings and buttons size</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_SIZE_DOCK_DESCRIPTION" Language="en_US">
			<Text>The size of the age, tech and civic rings and the buttons beside them. The base game's is about 130%.</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_SIZE_TRACKER" Language="en_US">
			<Text>World Tracker and Journal size</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_SIZE_TRACKER_DESCRIPTION" Language="en_US">
			<Text>The size of the World Tracker and the Journal. Bigger leaves the Journal less room, so it scrolls sooner.</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_SIZE_RIBBON" Language="en_US">
			<Text>Leader ribbon size</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_SIZE_RIBBON_DESCRIPTION" Language="en_US">
			<Text>The size of the leader ribbon. Bigger fits fewer leaders on screen. The base game's is 125%.</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_SIZE_MINIMAP_DESCRIPTION" Language="en_US">
			<Text>The size of the minimap and its lens buttons. The base game's is 125%.</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_SIZE_DIAL" Language="en_US">
			<Text>Turn dial size</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_SIZE_DIAL_DESCRIPTION" Language="en_US">
			<Text>The size of the turn dial. The base game's is 125%.</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_SIZE_NOTIFICATIONS" Language="en_US">
			<Text>Notifications size</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_SIZE_NOTIFICATIONS_DESCRIPTION" Language="en_US">
			<Text>The size of the notifications above the turn dial. The base game's is about 135%.</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_YIELD_TOTALS" Language="en_US">
			<Text>Food and production</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_OPTION_YIELD_TOTALS_DESCRIPTION" Language="en_US">
			<Text>Shows food and production for your whole empire after the other yields.</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_CELEBRATION_TURNS" Language="en_US">
