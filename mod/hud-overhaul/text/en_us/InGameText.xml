		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_CELEBRATION_STALLED" Language="en_US">
			<Text>([icon:CELEBRATION] -)</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_CELEBRATING" Language="en_US">
			<Text>([icon:CELEBRATION] {1_Turns} left)</Text>
		</Replace>
		<Replace Tag="LOC_HUD_OVERHAUL_CELEBRATION_TURNS_TOOLTIP" Language="en_US">
